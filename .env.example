# Environment Variables
# Reference: Implementation Plan §8 (Deployment & Demo Environment Plan)

# Anthropic Claude API key (required for Phase 2+)
ANTHROPIC_API_KEY=your-api-key-here

# Model to use for planning and explanation calls
MODEL_NAME=claude-sonnet-4-20250514

# Set to 'true' to run without LLM calls (uses hard-coded stubs)
STUB_MODE=true

# Path to data directory
DATA_DIR=data/synthetic

# Logging level
LOG_LEVEL=INFO
